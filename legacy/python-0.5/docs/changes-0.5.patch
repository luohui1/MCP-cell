+ .titlebar { padding:0 18px; gap:12px; }.window-tools { gap:4px; }.session-switch>span { display:none; }.session-switch select { max-width:160px; }
+ .page { padding:22px 18px 0; }.mcp-layout { grid-template-columns:165px minmax(0,1fr); }.source-sidebar { padding-right:12px; }.mcp-workspace { padding-left:18px; }
+ .source-filters button { gap:7px; }.source-filters button>span:not(.ai-logo) { font-size:11px; }.list-heading,.row { grid-template-columns:minmax(0,1fr) 100px 100px; }.row-actions { gap:8px; }.sources .source { max-width:100px; }
+}
