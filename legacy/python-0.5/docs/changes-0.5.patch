+/* 0.5: one MCP workspace, ordinary browser sizing, no decorative window chrome. */
+:root { --ink:#242a30; --muted:#6f7780; --line:#e6e9ed; --bg:#fff; --accent:#284b40; }
+html,body { margin:0; padding:0; width:100%; height:100%; }
+body { display:block; background:#fff; min-height:0; font-size:13px; }
+.window { width:100%; max-width:none; height:100dvh; max-height:none; min-height:0; margin:0; border:0; border-radius:0; background:#fff; box-shadow:none; }
+.titlebar { height:60px; padding:0 28px; gap:24px; background:#fff; border-bottom:1px solid var(--line); }
+.brand { font-size:16px; letter-spacing:-.4px; }
+.mark i,.mark i+i { border-radius:3px; }
+.version { font-size:10px; border-radius:3px; }
+.window-tools { gap:12px; margin-left:auto; min-width:0; }
+.header-action { padding:7px 9px; border:1px solid transparent; border-radius:4px; font-size:12px; white-space:nowrap; }
+.header-action:hover { background:#f3f5f6; border-color:#e9ecef; }
+.header-action>span { margin-left:4px; color:#828990; font-size:11px; }
+.connection { font-size:11px; margin-left:8px; }
+.icon-button { border-radius:4px; width:30px; height:30px; }
+.session-switch { display:flex; align-items:center; gap:7px; color:#737a81; font-size:11px; }
+.session-switch select { max-width:225px; }
+select { background:#fff; border:1px solid #dce1e5; border-radius:4px; padding:7px 9px; font-size:12px; color:#424a52; }
+#client[hidden] { display:none!important; }
+.control-label { display:flex; align-items:center; gap:8px; font-size:12px; color:#747c83; white-space:nowrap; }
+.page { padding:26px 28px 0; min-height:0; }
+.page .heading { margin-bottom:22px; min-height:34px; }
+.page .heading h1 { font-size:23px; letter-spacing:-.5px; line-height:1.5; }
+.heading-title { display:flex; gap:16px; align-items:baseline; }
+#inventory-count { font-size:12px; color:#7c858d; }
+.button { border-radius:4px; min-height:34px; padding:8px 12px; font-size:12px; background:#fff; box-shadow:none; }
+.button:hover:not(:disabled) { transform:none; background:#f5f7f8; }
+.button.primary { background:#294a3f; border-color:#294a3f; color:white; box-shadow:none; }
+.button.primary:hover:not(:disabled) { background:#365d50; }
+.button.primary:disabled { background:#eef1f2; border-color:#e2e6e8; color:#929ba1; }
+.mcp-layout { display:grid; grid-template-columns:190px minmax(0,1fr); gap:0; flex:1; min-height:0; border-top:1px solid var(--line); }
+.source-sidebar { display:flex; flex-direction:column; min-height:0; padding:22px 20px 18px 0; border-right:1px solid var(--line); }
+.sidebar-label { font-size:11px; color:#8a9299; margin:0 0 12px 10px; letter-spacing:.5px; }
+.source-filters { display:flex; flex-direction:column; align-items:stretch; gap:3px; padding:0; margin:0; overflow-x:hidden; overflow-y:auto; border:0; }
+.source-filters button { display:flex; align-items:center; justify-content:flex-start; gap:10px; width:100%; min-width:0; height:37px; flex-shrink:0; padding:8px 10px; border:1px solid transparent; border-radius:4px; background:transparent; color:#5c6670; }
+.source-filters button:hover { background:#f5f7f8; }
+.source-filters button[aria-pressed=true] { background:#eef4f1; border-color:#e7eeea; color:#274a3d; }
+.source-filters button>span:not(.ai-logo) { font-size:12px; text-align:left; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
+.source-filters button b { font-size:11px; font-weight:450; color:#8c959c; margin-left:auto; }
+.source-filters .ai-logo { flex-shrink:0; width:18px; height:18px; border-radius:2px; padding:0; background:none; border:0; box-shadow:none; }
+.source-filters .ai-logo svg { width:18px; height:18px; }
+.sidebar-note { margin:20px 0 0 10px; padding-top:14px; border-top:1px solid var(--line); font-size:10px; line-height:1.8; color:#89929a; }
+.mcp-workspace { display:flex; flex-direction:column; min-height:0; min-width:0; padding:22px 0 0 25px; }
+.toolbar { margin-bottom:17px; gap:16px; }
+.search { border-radius:4px; width:300px; max-width:55%; height:34px; padding:7px 10px; background:white; }
+.search input { font-size:12px; }
+.list-heading,.row { grid-template-columns:minmax(0,1fr) 140px 130px; }
+.list-heading { font-size:11px; padding-bottom:12px; color:#7a858e; border-bottom:1px solid var(--line); }
+.list { flex:1; min-height:0; overflow:auto; scrollbar-width:thin; scrollbar-color:#cdd3d8 transparent; }
+.row { min-height:69px; padding:12px 0; border-bottom:1px solid #edf0f2; border-radius:0; }
+.row.selected { background:#f4f8f5; }
+.name { font-size:13px; font-weight:600; }
+.sources { margin-top:6px; gap:7px; }
+.sources .source { font-size:10px; border-radius:3px; color:#78828a; }
+.sources .meta { font-size:10px; color:#889199; }
+.glyph { width:30px; height:30px; border-radius:4px; border:1px solid #edf0f2; background:#f8faf9; box-shadow:none; }
+.state { font-size:11px; border-radius:3px; color:#7a828b; }
+.row-button { font-size:12px; border-radius:4px; background:#f7f9f8; }
+.text-action { font-size:11px; }
+.row-actions { gap:14px; }
+.page .actionbar { min-height:64px; padding:15px 0; font-size:12px; border-top:1px solid var(--line); }
+#selection { font-size:12px; color:#7e878e; }
+#selection strong { color:#315346; }
+footer { min-height:35px; padding:8px 28px; background:#fbfcfc; border-top:1px solid var(--line); font-size:10px; }
+footer #summary { color:#7d868e; }
+.agent-toolbar { margin-bottom:20px; }
+.agent-cards { grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); gap:12px; }
+.agent-card { border-radius:6px; box-shadow:none; border-color:#e5e9ec; }
+.agent-card .agent-entry { border-radius:5px; min-height:132px; }
+.agent-entry strong { font-size:13px; }
+.ai-logo,.agent-entry .ai-logo { border-radius:4px; box-shadow:none; }
+.client-entry,.client-dock { border-radius:4px; }
+.client-dock-items { grid-template-columns:repeat(7,minmax(0,1fr)); }
+.detection-summary { border:0; background:#f7f9fa; border-radius:4px; font-size:12px; }
+.detected-row { border-radius:0; }
+.detected-item strong { font-size:13px; }
+.detected-item small { font-size:11px; }
+.session-panels { margin:0; }
+.terminal-tools button { border-radius:4px; padding:6px 9px; font-size:11px; }
+.terminal-toolbar { min-height:58px; padding:10px 28px; }
+.terminal-title strong { font-size:13px; }
+.terminal-title small { font-size:11px; }
+.terminal-wrap { padding:18px 26px 10px; }
+.terminal-note { padding:8px 28px; font-size:10px; }
+dialog { border-radius:8px; max-width:calc(100vw - 32px); }
+.notice,.detail-item,.dialog-status,.form-field input,.form-field select,.form-field textarea,.toast { border-radius:4px; }
+.more-button { border-radius:4px; }
